# Polymarket Paper Lab — copy to .env.local (or .env) if you need overrides.
# Local paper trading works with no secrets; all values below are optional.

# Directory for lab-state.json and trade-journal.jsonl.
# Relative paths resolve from the repository root. Default: data
# LAB_DATA_DIR=data

# Optional file-level overrides (absolute or repo-relative).
# LAB_STATE_FILE=
# LAB_JOURNAL_FILE=

# Vercel Blob — durable hosted state. Not required for local JSON persistence.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
